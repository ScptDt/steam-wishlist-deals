  "purpose": "Versioned taxonomy for classifying game engagement patterns. It classifies games, not player profiles.",
  "families": {
    "social": {
      "label": "Social",
      "description": "Games where memorable moments come primarily from other players.",
      "loops": ["emergent_social_chaos", "casual_party_fun", "social_deduction", "shared_stories", "friend_group_hangout", "voice_chat_moments"]
    },
    "coop_teamwork": {
      "label": "Co-op / teamwork",
      "description": "Games driven by coordination, shared objectives, roles, and rescue loops.",
      "loops": ["high_execution_coop", "tactical_coop", "role_based_teamwork", "shared_objective_pressure", "revive_rescue_loop", "asymmetric_coop"]
    },
    "competition": {
      "label": "Competition",
      "description": "Games motivated by outperforming opponents, climbing ladders, or PvP risk.",
      "loops": ["ranked_ladder_grind", "duel_mastery", "team_competitive_roles", "score_chasing", "extraction_risk_reward", "pvp_mindgames"]
    },
    "mastery_skill": {
      "label": "Mastery / skill",
      "description": "Games focused on player improvement, execution, patterns, or difficult mastery.",
      "loops": ["mechanical_execution", "boss_pattern_learning", "precision_platforming", "combo_mastery", "build_mastery", "learn_by_failure_loop"]
    },
    "action_arcade": {
      "label": "Action / arcade",
      "description": "Immediate action, reflexes, combat flow, hordes, or spectacle-driven play.",
      "loops": ["instant_action_loop", "power_fantasy_combat", "horde_clearing", "twitch_reflex_challenge", "run_and_gun_flow", "spectacle_mayhem"]
    },
    "optimization": {
      "label": "Optimization",
      "description": "Games about improving systems, builds, routes, economies, or efficiency.",
      "loops": ["factory_automation", "loadout_buildcraft", "deck_synergy_building", "resource_routing", "economy_minmaxing", "efficiency_chasing"]
    },
    "strategy_planning": {
      "label": "Strategy / planning",
      "description": "Planning, forecasting, positioning, and long-term strategic decision-making.",
      "loops": ["tactical_positioning", "turn_based_efficiency", "grand_strategy_planning", "long_term_campaign_planning", "crisis_management", "systems_forecasting"]
    },
    "management_simulation": {
      "label": "Management / simulation",
      "description": "Administering cities, colonies, businesses, sports teams, lives, or logistics.",
      "loops": ["colony_management", "city_building", "business_management", "sports_management", "life_sim_management", "logistics_orchestration"]
    },
    "exploration_discovery": {
      "label": "Exploration / discovery",
      "description": "Curiosity, traversal, hidden secrets, world discovery, and map completion.",
      "loops": ["open_world_wandering", "map_completion", "mystery_discovery", "metroidvania_unlocking", "environmental_storytelling", "hidden_secrets_hunting"]
    },
    "narrative": {
      "label": "Narrative",
      "description": "Story, characters, emotional payoff, lore, choices, and branching narratives.",
      "loops": ["cinematic_story", "choice_consequence", "emotional_one_shot", "character_relationships", "lore_deep_dive", "branching_storylines"]
    },
    "creativity_sandbox": {
      "label": "Creativity / sandbox",
      "description": "Building, designing, experimenting, modding, and freeform expression.",
      "loops": ["freeform_building", "base_design", "aesthetic_creation", "physics_experimentation", "modding_playground", "sandbox_experimentation"]
    },
    "collection_progression": {
      "label": "Collection / progression",
      "description": "Unlocks, loot, rosters, achievements, cosmetics, and completion loops.",
      "loops": ["loot_chasing", "number_go_up", "achievement_completion", "roster_collection", "cosmetic_unlocking", "completionist_checklists"]
    },
    "survival_pressure": {
      "label": "Survival / pressure",
      "description": "Surviving scarcity, hostility, time pressure, permadeath, or preparation risk.",
      "loops": ["resource_scarcity", "permadeath_tension", "time_pressure", "group_survival_pressure", "hostile_world_endurance", "risk_preparation_loop"]
    },
    "horror_tension": {
      "label": "Horror / tension",
      "description": "Fear, dread, vulnerability, uncertainty, jump scares, or psychological tension.",
      "loops": ["horror_vulnerability", "jumpscare_tension", "atmospheric_dread", "stalker_threat", "psychological_horror", "limited_information_fear"]
    },
    "comfort_cozy": {
      "label": "Comfort / cozy",
      "description": "Relaxed routine, low pressure progress, care, decoration, and cozy loops.",
      "loops": ["cozy_loop", "daily_routine", "low_pressure_grind", "caregiving_loop", "decorating_loop", "peaceful_progression"]
    },
    "puzzle_problem_solving": {
      "label": "Puzzle / problem solving",
      "description": "Logic, spatial, physics, word, escape-room, or optimization puzzle solving.",
      "loops": ["logic_deduction", "spatial_reasoning", "physics_puzzles", "word_pattern_solving", "escape_room_reasoning", "optimization_puzzles"]
    },
    "immersion_roleplay": {
      "label": "Immersion / roleplay",
      "description": "Living in a world, inhabiting a role, identity expression, or immersive systems.",
      "loops": ["roleplay_identity", "world_living", "simulated_career", "moral_alignment_play", "immersive_sim_problem_solving", "character_build_identity"]
    },
    "sports_racing": {
      "label": "Sports / racing",
      "description": "Sports, racing, handling, time trials, seasons, or physical competition fantasy.",
      "loops": ["race_line_mastery", "vehicle_handling_mastery", "sports_season_progression", "team_roster_management", "arcade_sports_fun", "time_trial_chasing"]
    },
    "simulation_realism": {
      "label": "Simulation / realism",
      "description": "Realistic procedures, vehicles, professions, systems, and slow-burn realism.",
      "loops": ["realistic_operation_loop", "procedure_mastery", "vehicle_simulation", "professional_role_simulation", "systems_realism", "slow_burn_realism"]
    },
    "rhythm_music": {
      "label": "Rhythm / music",
      "description": "Timing, beat matching, music flow, performance, and audio-visual sync.",
      "loops": ["beat_matching", "rhythm_execution", "music_flow_state", "performance_mastery", "audio_visual_sync", "playlist_replayability"]
    }
  },
